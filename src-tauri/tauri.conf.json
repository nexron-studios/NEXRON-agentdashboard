{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Dashboard - NEXRON",
  "version": "0.1.0",
  "identifier": "com.nexron.agentdashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Dashboard - NEXRON",
        "width": 1280,
        "height": 860,
        "minWidth": 820,
        "minHeight": 520,
        "visible": false,
        "backgroundColor": "#0f0f10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
